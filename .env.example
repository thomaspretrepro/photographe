# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# React App Environment Variables (publiques)
REACT_APP_CLOUDINARY_CLOUD_NAME=
