# Instagram API Configuration
# Pour obtenir un token d'accès Instagram :
# 1. Créer une app Facebook Developer : https://developers.facebook.com/
# 2. Ajouter le produit "Instagram Basic Display"
# 3. Configurer l'app et obtenir le token d'accès
# 4. Copier le token ci-dessous (sans les guillemets)

REACT_APP_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Autres variables d'environnement existantes
# (Ajoutez ici vos autres variables si nécessaire)

# Cloudinary (si utilisé)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# EmailJS (si utilisé pour le formulaire de contact)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key